# Frontend build-time API base. Leave blank for same-origin /api requests.
# For a separate API service, use its HTTPS origin (for example: https://api.example.com).
VITE_API_URL=

# Backend. PORT is supplied by most hosting platforms; 8787 is the local fallback.
# HOST defaults to 127.0.0.1 in development and 0.0.0.0 in production.
PORT=8787
MEDINEXUS_DB_PATH=data/medinexus.sqlite

# Local development origins. In production, replace these with the exact HTTPS
# frontend origin(s), comma-separated if needed. Wildcards are not supported.
MEDINEXUS_CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Optional provisioned accounts. Passwords must be configured in the hosting
# environment or a local .env file, never committed to source control.
MEDINEXUS_ADMIN_EMAIL=
MEDINEXUS_ADMIN_PASSWORD=
MEDINEXUS_ADMIN_NAME=
MEDINEXUS_DOCTOR_EMAIL=
MEDINEXUS_DOCTOR_PASSWORD=
MEDINEXUS_DOCTOR_NAME=
MEDINEXUS_STAFF_EMAIL=
MEDINEXUS_STAFF_PASSWORD=
MEDINEXUS_STAFF_NAME=

