# Server configuration
PORT=8787
MEDINEXUS_HOST=127.0.0.1
# Local development may use a relative path. Production must use an absolute path on persistent storage.
MEDINEXUS_DB_PATH=data/medinexus.sqlite
# Local Vite origin; production uses MEDINEXUS_PUBLIC_ORIGIN (same-origin deployment).
MEDINEXUS_CORS_ORIGIN=http://127.0.0.1:5173
# Optional extra frontend origins; production accepts HTTPS origins only.
MEDINEXUS_CORS_ORIGINS=

# Docker Compose + Caddy: replace these example values with a domain pointing at your server.
DOMAIN=medinexus.example.com
MEDINEXUS_PUBLIC_ORIGIN=https://medinexus.example.com

# Optional provisioned staff accounts. Keep secrets out of source control.
# Each new privileged account password must be at least 16 characters.
MEDINEXUS_ADMIN_EMAIL=
MEDINEXUS_ADMIN_PASSWORD=
MEDINEXUS_ADMIN_NAME=
MEDINEXUS_DOCTOR_EMAIL=
MEDINEXUS_DOCTOR_PASSWORD=
MEDINEXUS_DOCTOR_NAME=
MEDINEXUS_STAFF_EMAIL=
MEDINEXUS_STAFF_PASSWORD=
MEDINEXUS_STAFF_NAME=


# Security controls
# Trust X-Forwarded-For only when a reverse proxy overwrites that header.
MEDINEXUS_TRUST_PROXY=false
MEDINEXUS_AUTH_ATTEMPTS_PER_MINUTE=10
MEDINEXUS_REGISTRATIONS_PER_HOUR=5
# Set to true only for disposable local/test data. Production never seeds synthetic records.
MEDINEXUS_DEMO_DATA=true
